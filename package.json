    "@wdio/spec-reporter": "9.30.1",
    "appium": "3.6.0",
    "appium-inspector-plugin": "2026.7.1",
    "appium-uiautomator2-driver": "8.4.0",
    "eslint": "10.8.1",
    "eslint-plugin-wdio": "9.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
